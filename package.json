{
  "name": "vsa-website",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@supabase/ssr": "0.6.1",
    "@supabase/supabase-js": "2.50.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^16.18.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^2.30.0",
    "framer-motion": "^12.43.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.83.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.7.0",
    "react-query": "^3.39.3",
    "react-router-dom": "^6.30.1",
    "tailwind-merge": "^3.6.0",
    "typescript": "^4.9.5",
    "web-vitals": "^6.0.1",
    "zod": "^3.25.76"
  },
  "scripts": {
    "start": "node ./node_modules/react-scripts/bin/react-scripts.js start",
    "build": "node ./node_modules/react-scripts/bin/react-scripts.js build",
    "build:production": "node ./node_modules/react-scripts/bin/react-scripts.js build",
    "test": "node ./node_modules/react-scripts/bin/react-scripts.js test",
    "eject": "node ./node_modules/react-scripts/bin/react-scripts.js eject",
    "analyze": "npm run build && npx source-map-explorer 'build/static/js/*.js'",
    "analyze:css": "npm run build && npx source-map-explorer 'build/static/css/*.css'",
    "analyze:all": "npm run build && npx source-map-explorer 'build/static/**/*.{js,css}'",
    "lint": "eslint src/**/*.{ts,tsx}",
    "format": "prettier --write src/**/*.{ts,tsx}",
    "migrate:images:dry": "tsx scripts/migrate-supabase-images-to-public.ts",
    "migrate:images:apply": "tsx scripts/migrate-supabase-images-to-public.ts --apply",
    "migrate:house-assets:dry": "tsx scripts/migrate-supabase-images-to-public.ts --category houses",
    "migrate:house-assets:apply": "tsx scripts/migrate-supabase-images-to-public.ts --category houses --apply"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!(zod|@hookform/resolvers)/)"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.24",
    "prettier": "^3.9.6",
    "react-scripts": "^5.0.1",
    "sharp": "^0.35.3",
    "source-map-explorer": "^2.5.3",
    "tailwindcss": "^3.3.5",
    "tsx": "^4.23.1"
  }
}
