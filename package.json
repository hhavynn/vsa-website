{
  "name": "vsa-website",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^2.30.0",
    "framer-motion": "^12.43.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^20.1.2",
    "react-hook-form": "^7.89.0",
    "react-hot-toast": "^2.6.1",
    "react-icons": "^5.7.0",
    "react-query": "^3.39.3",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "typescript": "^4.9.5",
    "web-vitals": "^6.2.2",
    "zod": "^3.25.76"
  },
  "scripts": {
    "start": "node scripts/start-dev.cjs",
    "build": "node ./node_modules/react-scripts/bin/react-scripts.js build",
    "build:production": "node ./node_modules/react-scripts/bin/react-scripts.js build",
    "test": "node ./node_modules/react-scripts/bin/react-scripts.js test",
    "eject": "node ./node_modules/react-scripts/bin/react-scripts.js eject",
    "analyze": "npm run build && npx source-map-explorer 'build/static/js/*.js'",
    "analyze:css": "npm run build && npx source-map-explorer 'build/static/css/*.css'",
    "analyze:all": "npm run build && npx source-map-explorer 'build/static/**/*.{js,css}'",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "npx --yes -p typescript@5.6.3 tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck:edge": "deno check --no-lock 'supabase/functions/**/*.ts'",
    "test:edge": "deno test --no-lock --allow-env --import-map supabase/functions/_shared/test-import-map.json supabase/functions",
    "format": "prettier --write src/**/*.{ts,tsx}",
    "audit:image-exif": "node scripts/audit-image-exif.mjs",
    "migrate:images:dry": "tsx scripts/migrate-supabase-images-to-public.ts",
    "migrate:images:apply": "tsx scripts/migrate-supabase-images-to-public.ts --apply",
    "migrate:house-assets:dry": "tsx scripts/migrate-supabase-images-to-public.ts --category houses",
    "migrate:house-assets:apply": "tsx scripts/migrate-supabase-images-to-public.ts --category houses --apply",
    "migrate:images:relink": "tsx scripts/migrate-supabase-images-to-public.ts",
    "audit:storage-content": "tsx scripts/audit-storage-backed-content.ts",
    "test:timezones": "for tz in UTC America/New_York Asia/Ho_Chi_Minh America/Los_Angeles; do echo \"TZ=$tz\"; TZ=$tz CI=true node ./node_modules/react-scripts/bin/react-scripts.js test --watchAll=false src/lib/applicationWindowBoundaries src/lib/applicationWindows src/lib/adminAttention src/components/features/home/ClosingSoon src/pages/Admin/Applications.window src/utils/seasonalBoundaries src/utils/losAngelesDate src/lib/eventDayLabel src/pages/Admin/Events.bulk || exit 1; done"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!(zod|@hookform/resolvers)/)"
    ],
    "moduleNameMapper": {
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "react-scripts": "^5.0.1",
    "sharp": "^0.35.5",
    "source-map-explorer": "^2.5.3",
    "tailwindcss": "^3.3.5",
    "tsx": "^4.23.15"
  },
  "overrides": {
    "@svgr/webpack": "6.5.1",
    "resolve-url-loader": "5.0.0",
    "serialize-javascript": "7.1.2",
    "webpack-dev-middleware": "7.4.5",
    "http-proxy-agent": {
      "@tootallnate/once": "2.0.1"
    },
    "jsonpath": {
      "underscore": "1.13.8"
    },
    "sockjs": {
      "uuid": "11.1.1"
    },
    "webpack-dev-server": "5.2.6"
  }
}
