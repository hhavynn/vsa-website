# Copy this file to .env.local and fill in the values.
#
# ⚠️  Every REACT_APP_* variable is compiled into the PUBLIC client bundle.
#     Never put a server-side secret in this file or in .env.local.
#     Edge Function secrets — GEMINI_API_KEY, OPENAI_API_KEY, the Supabase
#     service-role key, Google OAuth credentials — are set as Supabase
#     secrets, not here. See .claude/skills/vsa-config-and-flags/.

# --- Required: the app will not boot without these ---
REACT_APP_SUPABASE_URL=your_supabase_url_here
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- Optional: analytics (GA4) ---
# Not needed for local development. Consumed by src/lib/analytics.ts and
# gated behind user consent — GA4 must not load before consent is given.
REACT_APP_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
