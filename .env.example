# Copy this file to .env.local and fill in the values.
#
# ⚠️  Every REACT_APP_* variable is compiled into the PUBLIC client bundle.
#     Never put a server-side secret in this file or in .env.local.
#     Edge Function secrets — GEMINI_API_KEY, OPENAI_API_KEY, the Supabase
#     service-role key, Google OAuth credentials — are set as Supabase
#     secrets, not here. See .claude/skills/vsa-config-and-flags/.

# --- Required: the app will not boot without these ---
REACT_APP_SUPABASE_URL=your_supabase_url_here
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- Optional: analytics ---
# NOTE: both Plausible and GA4 are configured here, and which one is live in
# production is currently unresolved — see issue #327. Leave these unset for
# local development; analytics are not needed to run the app.
REACT_APP_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
REACT_APP_PLAUSIBLE_DOMAIN=yourdomain.com
# Use if you proxy Plausible through a first-party endpoint later
# REACT_APP_PLAUSIBLE_API_HOST=https://plausible.io
# Use a site-specific Plausible snippet instead of REACT_APP_PLAUSIBLE_DOMAIN
# REACT_APP_PLAUSIBLE_SCRIPT_SRC=https://plausible.io/js/pa-your-site-id.js
# Set to true if your Plausible snippet requires plausible.init()
# REACT_APP_PLAUSIBLE_MANUAL_INIT=true
