{
  "name": "vsa-ace-recap-video",
  "private": true,
  "description": "Renders the ACE annual recap MP4 locally from a reviewed snapshot. Never deployed; not part of the website bundle.",
  "license": "MIT",
  "scripts": {
    "studio": "remotion studio src/index.ts --props=fixtures/synthetic-props.json",
